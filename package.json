{
  "name": "map-tools",
  "private": true,
  "version": "2.0.0",
  "description": "Map Tools browser application",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" vite.config.ts",
    "test": "tsx --test tests/*.test.js tests/*.test.ts",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "serve": "vite --host 127.0.0.1 --port 4173",
    "serve:dist": "vite preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^26.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4"
  }
}
